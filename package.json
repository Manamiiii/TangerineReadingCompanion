{
  "name": "tangerine-reading-companion",
  "private": true,
  "version": "0.1.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "Local-first reading memories and maps that respect your reading progress",
  "author": "Tangerine Reading Companion contributors",
  "repository": "https://github.com/Manamiiii/TangerineReadingCompanion.git",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:privacy && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:packages": "node scripts/reading-companion/validate-packages.mjs",
    "check:privacy": "node scripts/check-repository-privacy.mjs",
    "audit:quality": "node scripts/reading-companion/audit-quality.mjs",
    "audit:links": "node scripts/reading-companion/audit-quality.mjs --check-links",
    "preview:data": "node scripts/reading-companion/build-preview.mjs",
    "check:preset": "node scripts/reading-companion/apply-preview.mjs",
    "apply:preset": "node scripts/reading-companion/apply-preview.mjs --write",
    "test": "node --test scripts/reading-companion/tests/*.test.mjs scripts/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check:native": "node scripts/check-native-environment.mjs",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win --x64 --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never && node scripts/desktop/checksums.mjs",
    "test:desktop": "node scripts/desktop/smoke.mjs && node scripts/desktop/local-model.mjs && node scripts/desktop/storage-smoke.mjs",
    "test:installer": "node scripts/desktop/installer-smoke.mjs",
    "build:installer-fixture": "electron-builder --win nsis --x64 --publish never --config.nsis.include=scripts/desktop/legacy-layout.nsh --config.extraMetadata.version=0.0.9 --config.directories.output=artifacts/desktop/upgrade-fixture && electron-builder --win nsis --x64 --publish never --config.nsis.include=scripts/desktop/previous-layout.nsh --config.extraMetadata.version=0.1.1 --config.directories.output=artifacts/desktop/previous-layout-fixture",
    "check:desktop-package": "node scripts/desktop/audit-package.mjs && node scripts/desktop/audit-icons.mjs",
    "review:prepare": "node scripts/review-entry.mjs prepare",
    "review:check": "node scripts/review-entry.mjs check",
    "review:verify": "node scripts/verify-review.mjs"
  },
  "build": {
    "appId": "org.tangerine.readingcompanion",
    "productName": "橘子阅读伴侣",
    "directories": {
      "output": "artifacts/desktop/release/${version}"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "TangerineReadingCompanion",
      "icon": "assets/tangerine-reading-companion.ico",
      "signExecutable": false
    },
    "nsis": {
      "guid": "30761e87-4597-4359-98de-25b26c2c752d",
      "artifactName": "TangerineReadingCompanion-${version}-win-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "橘子阅读伴侣",
      "installerIcon": "assets/tangerine-reading-companion.ico",
      "uninstallerIcon": "assets/tangerine-reading-companion.ico",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "include": "desktop/installer.nsh"
    }
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "fake-indexeddb": "^6.2.4",
    "oxlint": "^1.74.0",
    "vite": "~8.1.6"
  }
}
