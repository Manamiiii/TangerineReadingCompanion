{
  "name": "Tangerine Reading Companion",
  "image": "mcr.microsoft.com/devcontainers/universal:5",
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ]
    }
  },
  "mounts": [
    "source=tangerine-reading-companion-codex-home,target=/home/codespace/.codex,type=volume"
  ],
  "remoteEnv": {
    "CODEX_HOME": "/home/codespace/.codex"
  },
  "forwardPorts": [5174],
  "portsAttributes": {
    "5174": {
      "label": "Tangerine Reading Companion",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
